  "description": "Chat Buddy: a chatbot with a Node/Express backend for real user accounts, server-side persistence, and document intelligence (PDF/DOCX/TXT).",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "vectra": "^0.15.0"
