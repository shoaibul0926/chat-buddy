JWT_SECRET=change-this-to-a-long-random-string
PORT=3001
# Path where data.json and uploads/ are stored. In production, point this at
# a mounted persistent volume — without one, all accounts and files are lost
# on every container restart, not just redeploys. Defaults to the app
# directory (fine for local dev).
DATA_DIR=/data
# Optional. Enables semantic (embeddings-based) document Q&A via Voyage AI
# instead of plain keyword matching — get a key at https://dash.voyageai.com.
# Without it, uploaded-file Q&A automatically falls back to keyword search.
# Also powers RAG retrieval for real AI chat (see ANTHROPIC_API_KEY/OPENAI_API_KEY
# below) — without it, AI chat still works, just without knowledge-base/file grounding.
VOYAGE_API_KEY=

# Optional — set at least one to enable real LLM-powered chat (streaming,
# prompt templates, custom system prompts). Without either set, chat stays
# the original rule-based bot. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
